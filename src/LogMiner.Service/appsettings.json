{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.Hosting.Lifetime": "Information" }
  },
  "LogMiner": {
    "ServerName": "sql01",
    "Scope": "CdcTrackedTables",
    "StartPosition": "Auto",
    "Databases": [ "tenant_*" ],
    "ExcludeDatabases": [],
    "Workers": 8,
    "CheckpointIntervalMs": 1000,
    "ReleaseIntervalMs": 10000,
    "ReleaseLog": true,
    "SelfTest": "Require",
    "OnGap": "Resync",
    "MaxHeldLogMb": 64,
    "State": { "Type": "SqlServer", "Database": "logminer" },
    "Signal": { "Push": true, "DispatchIntervalMs": 4, "AuditIntervalMs": 1000, "FullPollIntervalMs": 100, "HotPollIntervalMs": 5, "HotWindowSeconds": 10 },
    "Routing": {
      "DestinationTemplate": "cdc.{server}.{db}.{schema}.{table}",
      "PartitionKey": "Database"
    },
    "Sink": {
      "Type": "nats-jetstream",
      "Spool": {
        "Enabled": false,
        "Directory": "C:\\ProgramData\\logminer\\spool",
        "AckOn": "Delivered",
        "MaxBytes": 21474836480
      },
      "NatsJetStream": {
        "Url": "nats://127.0.0.1:4222",
        "Stream": "LOGMINER",
        "Subjects": [ "cdc.>" ],
        "Replicas": 1,
        "DuplicateWindowMinutes": 10,
        "MaxAgeDays": 7
      },
      "File": { "Directory": "C:\\ProgramData\\logminer\\events" }
    }
  }
}
