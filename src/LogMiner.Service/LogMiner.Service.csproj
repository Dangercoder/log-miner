    <RootNamespace>LogMiner.Service</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>logminer</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <ProjectReference Include="..\LogMiner.Core\LogMiner.Core.csproj" />
    <ProjectReference Include="..\LogMiner.SqlServer\LogMiner.SqlServer.csproj" />
    <ProjectReference Include="..\LogMiner.Nats\LogMiner.Nats.csproj" />
  </ItemGroup>
</Project>
