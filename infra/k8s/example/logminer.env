# Settings of logminer for this SQL Server instance: the ConfigMap logminer-config, environment variables of the pods. Nothing secret here
# (passwords go into secret.env). Every setting with its default: docs/kubernetes.md.
# Format: KEY=VALUE, one per line; no quotes (they would be part of the value); comments only on lines of their own.

# The name of this SQL Server instance in the subjects, the lease and the positions. Never change it once events were published.
LogMiner__ServerName=sql01

# --- SQL Server (the password is in secret.env) ---
LogMiner__Sql__Host=sql01.example.internal
LogMiner__Sql__Port=1433
LogMiner__Sql__User=logminer
# The connection is encrypted and the server's certificate checked. If it is issued to another name than Host:
#LogMiner__Sql__HostNameInCertificate=sql01.example.internal
# If nobody your pods trust signed it, pin the certificate itself (a file, see kustomization.yaml):
#LogMiner__Sql__ServerCertificate=/etc/logminer/files/sql01.cer
# Databases to capture, * and ? as wildcards; more as __1, __2 ... Empty: every database with CDC enabled.
LogMiner__Databases__0=tenant_*
#LogMiner__ExcludeDatabases__0=tenant_test_*

# --- NATS (a password or token is in secret.env) ---
# One server, or the servers of a cluster separated by commas.
LogMiner__Sink__NatsJetStream__Url=nats://nats.nats.svc.cluster.local:4222
LogMiner__Sink__NatsJetStream__Stream=LOGMINER
# Replicas of the stream when logminer creates it (only then): 3 with three NATS servers.
LogMiner__Sink__NatsJetStream__Replicas=3
#LogMiner__Sink__NatsJetStream__User=logminer
#LogMiner__Sink__NatsJetStream__CredentialsFile=/etc/logminer/files/nats.creds
#LogMiner__Sink__NatsJetStream__TlsCaFile=/etc/logminer/files/nats-ca.pem

# --- the rest ---
# Row images of open transactions buffered per database: several large transactions at once must fit the pod's memory limit (2Gi).
LogMiner__MaxBufferedMb=512
Logging__Console__FormatterName=json
