# Copy to secret.env (git-ignored) and fill in: the Secret logminer-secret, every line an environment variable of the pods.
# Format: KEY=VALUE; no quotes (they would be part of the value), nothing after the value. An empty value counts as not set.
LogMiner__Sql__Password=
LogMiner__Sink__NatsJetStream__Password=
